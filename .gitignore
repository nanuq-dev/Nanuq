# =============================================================================
# .gitignore - Fichiers et dossiers à ne PAS versionner avec Git
# =============================================================================

# --- Environnements virtuels Python ---
.venv/
venv/
env/
ENV/

# --- Caches Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Tests et couverture ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Outils de qualité ---
.ruff_cache/
.mypy_cache/
.dmypy.json

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE / éditeurs ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- uv ---
uv.lock
